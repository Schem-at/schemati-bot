# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=

# Dev mode: only responds to the dev guild and deploys commands there only
DEV_MODE=false

# PostgreSQL connection to the Schemati database.
# Either set DATABASE_URL, or the discrete Laravel-style DB_* variables below (so the bot
# can reuse the same environment as the web application).
DATABASE_URL=postgresql://user:password@localhost:5432/schemati
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=schemati
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=

# Schemati API. Must be the public app URL (it builds clickable links in Discord).
# Falls back to APP_URL when API_BASE_URL is unset.
API_BASE_URL=http://localhost
# APP_URL=
API_TOKEN=

# Object storage. Falls back to AWS_URL when STORAGE_BASE_URL is unset.
STORAGE_BASE_URL=http://localhost:9000

# Redis (pub/sub events from the web application).
# Either set REDIS_URL, or the discrete REDIS_* variables below.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# Must match the web application's Redis key prefix. Defaults to slug(APP_NAME)_database_.
REDIS_PREFIX=schemati_database_

# Shared secret used to authenticate bot uploads to the API.
# Must match the web application's BOT_SECRET.
BOT_SECRET=
