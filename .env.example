# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=

# Dev mode: only responds to the dev guild and deploys commands there only
DEV_MODE=false

# PostgreSQL connection to the Schemati database
DATABASE_URL=postgresql://user:password@localhost:5432/schemati

# Schemati API
API_BASE_URL=http://localhost
API_TOKEN=

# Object storage
STORAGE_BASE_URL=http://localhost:9000

# Redis (pub/sub events from the web application)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=schemati_database_

# Shared secret used to verify requests
BOT_SECRET=
